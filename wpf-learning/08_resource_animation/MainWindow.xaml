<Window x:Class="LessonWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF 리소스와 애니메이션"
        Height="550"
        Width="650"
        WindowStartupLocation="CenterScreen">
    <!--
    ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
    ■  WPF 08 - 리소스와 애니메이션                           ■
    ■  움직이는 UI 요소 만들기                                 ■
    ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

    이 파일에서 배우는 것:
      1) StaticResource     - 고정된 자원 (한 번 가져오면 끝)
      2) DynamicResource    - 동적 자원 (나중에 바꿀 수 있음)
      3) ResourceDictionary - 자원 사전 (물건 보관 창고)
      4) Storyboard         - 애니메이션 시나리오 (영화 대본)
      5) DoubleAnimation    - 숫자 값을 점점 바꾸기 (크기, 위치)
      6) ColorAnimation     - 색상을 점점 바꾸기 (빨강→파랑)

    비유:
      Resource = 물감 보관함 (자주 쓰는 색을 넣어둠)
      StaticResource = 한 번 짜놓은 물감 (안 바뀜)
      DynamicResource = 바꿀 수 있는 물감 (나중에 다른 색으로 교체 가능)
      Storyboard = 애니메이션 대본 ("3초 동안 왼쪽에서 오른쪽으로 이동")
    -->

    <Window.Resources>
        <!-- ┌─────────────────────────────────────────┐ -->
        <!-- │  리소스 정의 - 자주 쓰는 값 저장          │ -->
        <!-- └─────────────────────────────────────────┘ -->
        <!-- Resource는 자주 쓰는 값을 한 곳에 모아두는 것입니다.
             물감 보관함에 자주 쓰는 색을 넣어두면
             매번 새로 섞을 필요가 없어요! -->

        <!-- 색상 리소스 -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#FF3F51B5" />
        <SolidColorBrush x:Key="AccentColor" Color="#FFFF5722" />
        <SolidColorBrush x:Key="BackgroundColor" Color="#FFF5F5F5" />

        <!-- 숫자 리소스 -->
        <sys:Double x:Key="TitleSize"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">22</sys:Double>
        <sys:Double x:Key="NormalSize"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>

        <!-- ┌─────────────────────────────────────────┐ -->
        <!-- │  애니메이션 Storyboard 정의              │ -->
        <!-- └─────────────────────────────────────────┘ -->
        <!-- Storyboard는 영화 대본과 같습니다.
             "이 배우(컨트롤)가 3초 동안 이렇게 움직여라"라고 적어둡니다.

             DoubleAnimation: 숫자를 점점 바꿈
               From="0" To="300" Duration="0:0:1"
               → 0에서 300까지 1초 동안 변화

             ColorAnimation: 색상을 점점 바꿈
               From="Red" To="Blue" Duration="0:0:2"
               → 빨강에서 파랑으로 2초 동안 변화 -->

        <!-- 이동 애니메이션 -->
        <Storyboard x:Key="SlideAnimation">
            <DoubleAnimation
                Storyboard.TargetName="AnimatedBox"
                Storyboard.TargetProperty="(Canvas.Left)"
                From="0" To="350"
                Duration="0:0:2"
                AutoReverse="True"
                RepeatBehavior="Forever">
                <!-- AutoReverse: 끝에 도달하면 반대로 돌아옴 (왕복)
                     RepeatBehavior: Forever = 무한 반복 -->
                <DoubleAnimation.EasingFunction>
                    <!-- EasingFunction: 속도 변화 패턴
                         BounceEase = 공이 튀는 것처럼 (통통!) -->
                    <BounceEase Bounces="3" Bounciness="2" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 크기 변화 애니메이션 -->
        <Storyboard x:Key="PulseAnimation">
            <DoubleAnimation
                Storyboard.TargetName="PulseCircle"
                Storyboard.TargetProperty="Width"
                From="50" To="100"
                Duration="0:0:0.8"
                AutoReverse="True"
                RepeatBehavior="Forever" />
            <DoubleAnimation
                Storyboard.TargetName="PulseCircle"
                Storyboard.TargetProperty="Height"
                From="50" To="100"
                Duration="0:0:0.8"
                AutoReverse="True"
                RepeatBehavior="Forever" />
        </Storyboard>

        <!-- 색상 변화 애니메이션 -->
        <Storyboard x:Key="ColorAnimation">
            <ColorAnimation
                Storyboard.TargetName="ColorBox"
                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                From="#FF2196F3" To="#FFF44336"
                Duration="0:0:2"
                AutoReverse="True"
                RepeatBehavior="Forever" />
        </Storyboard>

        <!-- 회전 애니메이션 -->
        <Storyboard x:Key="RotateAnimation">
            <DoubleAnimation
                Storyboard.TargetName="RotateTransform"
                Storyboard.TargetProperty="Angle"
                From="0" To="360"
                Duration="0:0:3"
                RepeatBehavior="Forever" />
        </Storyboard>

        <!-- 투명도 애니메이션 -->
        <Storyboard x:Key="FadeAnimation">
            <DoubleAnimation
                Storyboard.TargetName="FadeBox"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0.1"
                Duration="0:0:1.5"
                AutoReverse="True"
                RepeatBehavior="Forever" />
        </Storyboard>
    </Window.Resources>

    <DockPanel Background="{StaticResource BackgroundColor}">
        <!-- 제목 (StaticResource 사용) -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PrimaryColor}"
                Padding="15,12">
            <TextBlock Text="리소스 &amp; 애니메이션 갤러리"
                       FontSize="{StaticResource TitleSize}"
                       FontWeight="Bold"
                       Foreground="White" />
        </Border>

        <ScrollViewer Padding="15">
            <StackPanel>
                <!-- ┌─────────────────────────────────┐ -->
                <!-- │  DynamicResource 테마 변경        │ -->
                <!-- └─────────────────────────────────┘ -->
                <TextBlock Text="1. DynamicResource - 테마 변경"
                           FontSize="16" FontWeight="Bold"
                           Margin="0,5,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="파란 테마" Padding="15,8" Margin="0,0,8,0"
                            Click="OnBlueTheme" />
                    <Button Content="초록 테마" Padding="15,8" Margin="0,0,8,0"
                            Click="OnGreenTheme" />
                    <Button Content="주황 테마" Padding="15,8"
                            Click="OnOrangeTheme" />
                </StackPanel>
                <!-- DynamicResource로 설정하면 런타임에 리소스를 바꿀 수 있습니다!
                     StaticResource는 한 번 정해지면 못 바꿉니다. -->
                <Border Background="{DynamicResource PrimaryColor}"
                        Padding="15" CornerRadius="8" Margin="0,0,0,15">
                    <TextBlock Text="이 배경색은 DynamicResource로 설정되어 버튼 클릭 시 변경됩니다!"
                               Foreground="White" FontSize="14" TextWrapping="Wrap" />
                </Border>

                <!-- ┌─────────────────────────────────┐ -->
                <!-- │  애니메이션 예제들                 │ -->
                <!-- └─────────────────────────────────┘ -->
                <TextBlock Text="2. 애니메이션 예제"
                           FontSize="16" FontWeight="Bold"
                           Margin="0,5,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="모든 애니메이션 시작" Padding="15,8" Margin="0,0,8,0"
                            Click="OnStartAll" Background="{StaticResource AccentColor}"
                            Foreground="White" />
                    <Button Content="모든 애니메이션 중지" Padding="15,8"
                            Click="OnStopAll" />
                </StackPanel>

                <!-- 이동 애니메이션 -->
                <TextBlock Text="이동 (DoubleAnimation + BounceEase):" Margin="0,10,0,5" />
                <Canvas Height="60" Background="White" Margin="0,0,0,10">
                    <Border x:Name="AnimatedBox"
                            Canvas.Left="0" Canvas.Top="10"
                            Width="40" Height="40"
                            CornerRadius="5"
                            Background="#FF2196F3" />
                </Canvas>

                <!-- 맥동 애니메이션 -->
                <TextBlock Text="크기 변화 (Pulse):" Margin="0,5,0,5" />
                <Canvas Height="110" Background="White" Margin="0,0,0,10">
                    <Ellipse x:Name="PulseCircle"
                             Canvas.Left="30" Canvas.Top="5"
                             Width="50" Height="50"
                             Fill="#FF4CAF50" />
                </Canvas>

                <!-- 색상 변화 -->
                <TextBlock Text="색상 변화 (ColorAnimation):" Margin="0,5,0,5" />
                <Border x:Name="ColorBox"
                        Height="50" CornerRadius="8"
                        Background="#FF2196F3"
                        Margin="0,0,0,10" />

                <!-- 회전 -->
                <TextBlock Text="회전 (RotateTransform):" Margin="0,5,0,5" />
                <Canvas Height="80" Background="White" Margin="0,0,0,10">
                    <Border Canvas.Left="30" Canvas.Top="5"
                            Width="60" Height="60"
                            Background="#FF9C27B0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform x:Name="RotateTransform" Angle="0" />
                        </Border.RenderTransform>
                        <TextBlock Text="회전!" Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold" />
                    </Border>
                </Canvas>

                <!-- 투명도 -->
                <TextBlock Text="투명도 (Opacity):" Margin="0,5,0,5" />
                <Border x:Name="FadeBox"
                        Height="50" CornerRadius="8"
                        Background="#FFFF9800"
                        Margin="0,0,0,10">
                    <TextBlock Text="나타났다 사라졌다!"
                               Foreground="White" FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
