<Window x:Class="LessonWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF 스타일과 템플릿 - 테마 버튼 갤러리"
        Height="600"
        Width="700"
        WindowStartupLocation="CenterScreen">
    <!--
    ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
    ■  WPF 04 - 스타일과 템플릿 (Styles & Templates)         ■
    ■  테마 버튼 갤러리 만들기                                 ■
    ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

    이 파일에서 배우는 것:
      1) Style     - 컨트롤의 옷 (교복처럼 통일된 스타일)
      2) Setter    - 스타일의 세부 설정 (교복 색, 크기)
      3) Trigger   - 조건에 따라 변하는 스타일 (비 오면 우산)
      4) DataTrigger    - 데이터에 따라 변하는 스타일
      5) ControlTemplate - 컨트롤의 뼈대를 바꾸기 (건물 설계도 변경)
      6) DataTemplate    - 데이터를 어떻게 보여줄지 (이력서 양식)
    -->

    <Window.Resources>
        <!-- ┌─────────────────────────────────────────┐ -->
        <!-- │  Style - 컨트롤의 교복                    │ -->
        <!-- └─────────────────────────────────────────┘ -->
        <!-- Style은 교복과 같습니다.
             한 번 정의하면 여러 컨트롤이 같은 옷을 입습니다.
             x:Key를 붙이면 "특별 교복" → 원하는 컨트롤에만 적용
             x:Key가 없으면 "기본 교복" → 해당 타입의 모든 컨트롤에 적용 -->

        <!-- 기본 버튼 스타일 (모든 Button에 자동 적용) -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="맑은 고딕" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- ┌─────────────────────────────────────────┐ -->
        <!-- │  Trigger가 있는 스타일                    │ -->
        <!-- └─────────────────────────────────────────┘ -->
        <!-- Trigger는 "만약 ~하면 ~해라"입니다.
             비가 오면 우산을 펴는 것처럼,
             마우스를 올리면 색이 변합니다. -->

        <!-- 파란색 테마 버튼 -->
        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2196F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <!-- IsMouseOver Trigger: 마우스를 올리면 색이 진해짐 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1976D2" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
                <!-- IsPressed Trigger: 클릭하면 더 진해짐 -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF0D47A1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 초록색 테마 버튼 -->
        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4CAF50" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF388E3C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 빨간색 경고 버튼 -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF44336" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFD32F2F" />
                </Trigger>
                <!-- IsEnabled Trigger: 비활성화되면 회색으로 -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FFBDBDBD" />
                    <Setter Property="Foreground" Value="#FF757575" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ┌─────────────────────────────────────────┐ -->
        <!-- │  ControlTemplate - 컨트롤 뼈대 바꾸기    │ -->
        <!-- └─────────────────────────────────────────┘ -->
        <!-- ControlTemplate은 건물의 설계도를 완전히 바꾸는 것입니다.
             기본 네모난 버튼을 동그란 버튼으로 만들 수 있어요!
             건물 외관을 벽돌집에서 통나무집으로 바꾸는 것과 같습니다. -->
        <Style x:Key="RoundButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="80" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 원형 테두리 -->
                        <Border x:Name="border"
                                Background="#FF9C27B0"
                                CornerRadius="40"
                                BorderThickness="3"
                                BorderBrush="#FF7B1FA2">
                            <!-- ContentPresenter: 버튼의 Content를 여기에 표시 -->
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="White"
                                              TextBlock.FontSize="14" />
                        </Border>
                        <!-- ControlTemplate 안의 Trigger -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE040FB" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFE040FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ┌─────────────────────────────────────────┐ -->
        <!-- │  DataTemplate - 데이터 표시 양식          │ -->
        <!-- └─────────────────────────────────────────┘ -->
        <!-- DataTemplate은 이력서 양식과 같습니다.
             데이터(이름, 나이)를 어떤 형태로 보여줄지 정합니다.
             같은 사람 정보도 이력서 양식이 다르면 다르게 보이듯이! -->
        <DataTemplate x:Key="ColorItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="3">
                <Border Width="24" Height="24"
                        CornerRadius="4"
                        Background="{Binding Color}"
                        Margin="0,0,8,0" />
                <TextBlock Text="{Binding Name}"
                           FontSize="13"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- 제목 -->
        <Border DockPanel.Dock="Top"
                Background="#FF37474F"
                Padding="20,15">
            <TextBlock Text="스타일 &amp; 템플릿 갤러리"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="15">
            <StackPanel>
                <!-- 섹션 1: 기본 스타일 버튼 -->
                <TextBlock Text="1. 테마 버튼 (Style + Trigger)"
                           FontSize="16" FontWeight="Bold"
                           Margin="0,10,0,5" />
                <WrapPanel>
                    <Button Content="파란 버튼" Style="{StaticResource BlueButtonStyle}"
                            Click="OnButtonClick" />
                    <Button Content="초록 버튼" Style="{StaticResource GreenButtonStyle}"
                            Click="OnButtonClick" />
                    <Button Content="경고 버튼" Style="{StaticResource DangerButtonStyle}"
                            Click="OnButtonClick" />
                    <Button Content="비활성 버튼" Style="{StaticResource DangerButtonStyle}"
                            IsEnabled="False" />
                </WrapPanel>

                <!-- 섹션 2: 둥근 버튼 (ControlTemplate) -->
                <TextBlock Text="2. 둥근 버튼 (ControlTemplate)"
                           FontSize="16" FontWeight="Bold"
                           Margin="0,20,0,5" />
                <WrapPanel>
                    <Button Content="홈" Style="{StaticResource RoundButtonStyle}"
                            Click="OnButtonClick" />
                    <Button Content="검색" Style="{StaticResource RoundButtonStyle}"
                            Click="OnButtonClick" />
                    <Button Content="설정" Style="{StaticResource RoundButtonStyle}"
                            Click="OnButtonClick" />
                    <Button Content="정보" Style="{StaticResource RoundButtonStyle}"
                            Click="OnButtonClick" />
                </WrapPanel>

                <!-- 섹션 3: DataTemplate 예제 -->
                <TextBlock Text="3. 색상 목록 (DataTemplate)"
                           FontSize="16" FontWeight="Bold"
                           Margin="0,20,0,5" />
                <ListBox x:Name="ColorList"
                         ItemTemplate="{StaticResource ColorItemTemplate}"
                         Height="150"
                         Margin="0,5" />

                <!-- 결과 표시 -->
                <Border Margin="0,15"
                        Padding="15"
                        Background="#FFFFF3E0"
                        CornerRadius="8">
                    <TextBlock x:Name="ResultText"
                               Text="버튼을 클릭하면 결과가 여기에 표시됩니다."
                               FontSize="14"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
