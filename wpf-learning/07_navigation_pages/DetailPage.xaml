<Page x:Class="LessonWpf.DetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="추가 정보">
    <!--
    ┌─────────────────────────────────────────────┐
    │  2단계: 추가 정보 입력 페이지                 │
    └─────────────────────────────────────────────┘
    이전 페이지에서 전달받은 데이터를 이어서 사용합니다.
    쪽지를 받아서 내용을 추가해서 다음 사람에게 전달하는 것!
    -->

    <StackPanel Margin="25">
        <TextBlock Text="추가 정보를 입력하세요"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <!-- 전화번호 입력 -->
        <TextBlock Text="전화번호:" FontSize="14" Margin="0,0,0,5" />
        <TextBox x:Name="PhoneBox"
                 FontSize="14"
                 Padding="8,5"
                 Margin="0,0,0,12" />

        <!-- 취미 입력 -->
        <TextBlock Text="취미:" FontSize="14" Margin="0,0,0,5" />
        <TextBox x:Name="HobbyBox"
                 FontSize="14"
                 Padding="8,5"
                 Margin="0,0,0,12" />

        <!-- 약관 동의 -->
        <CheckBox x:Name="AgreeCheck"
                  Content="이용약관에 동의합니다"
                  FontSize="14"
                  Margin="0,10,0,0" />

        <!-- 안내 메시지 -->
        <Border Background="#FFE8F5E9"
                Padding="12"
                CornerRadius="6"
                Margin="0,15,0,20">
            <TextBlock TextWrapping="Wrap" FontSize="13">
                "뒤로" 버튼을 누르면 이전 페이지로 돌아갑니다.
                GoBack()은 브라우저의 "뒤로가기" 버튼과 같습니다!
                데이터는 공유 객체(RegistrationData)에 저장되어
                페이지를 이동해도 사라지지 않습니다.
            </TextBlock>
        </Border>

        <!-- 네비게이션 버튼 -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="&lt; 이전"
                    Padding="25,10"
                    FontSize="14"
                    Margin="0,0,10,0"
                    Click="OnBack" />
            <Button Content="완료"
                    Padding="25,10"
                    FontSize="14"
                    Background="#FF4CAF50"
                    Foreground="White"
                    Click="OnComplete" />
        </StackPanel>
    </StackPanel>
</Page>
