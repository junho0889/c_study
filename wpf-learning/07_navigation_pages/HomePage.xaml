<Page x:Class="LessonWpf.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="기본 정보">
    <!--
    ┌─────────────────────────────────────────────┐
    │  1단계: 기본 정보 입력 페이지                 │
    └─────────────────────────────────────────────┘
    Page는 Frame 안에서 보여지는 한 "장면"입니다.
    영화에서 한 장면(Scene)과 같아요!
    Window와 비슷하지만, 혼자 띄울 수 없고 Frame 안에 들어갑니다.
    -->

    <StackPanel Margin="25">
        <TextBlock Text="기본 정보를 입력하세요"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <!-- 이름 입력 -->
        <TextBlock Text="이름:" FontSize="14" Margin="0,0,0,5" />
        <TextBox x:Name="NameBox"
                 FontSize="14"
                 Padding="8,5"
                 Margin="0,0,0,12" />

        <!-- 이메일 입력 -->
        <TextBlock Text="이메일:" FontSize="14" Margin="0,0,0,5" />
        <TextBox x:Name="EmailBox"
                 FontSize="14"
                 Padding="8,5"
                 Margin="0,0,0,12" />

        <!-- 안내 메시지 -->
        <Border Background="#FFF3E5F5"
                Padding="12"
                CornerRadius="6"
                Margin="0,10,0,20">
            <TextBlock TextWrapping="Wrap"
                       FontSize="13">
                Page는 Frame 안에서 보여지는 화면입니다.
                "다음" 버튼을 누르면 NavigationService를 통해
                다음 페이지로 이동합니다. (리모컨으로 채널을 바꾸는 것!)
            </TextBlock>
        </Border>

        <!-- 네비게이션 버튼 -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="다음 >"
                    Padding="25,10"
                    FontSize="14"
                    Background="#FF3F51B5"
                    Foreground="White"
                    Click="OnNext" />
        </StackPanel>
    </StackPanel>
</Page>
