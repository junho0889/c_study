<Window x:Class="LessonWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LessonWpf"
        Title="WPF 컬렉션 - 학생 목록 관리"
        Height="550"
        Width="700"
        WindowStartupLocation="CenterScreen">
    <!--
    ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
    ■  WPF 06 - 컬렉션과 ListBox                             ■
    ■  학생 목록 관리 앱 만들기                                 ■
    ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

    이 파일에서 배우는 것:
      1) ObservableCollection - 자동 알림 목록 (출석부가 자동 업데이트)
      2) ListBox + DataTemplate - 목록 항목의 모양 정하기
      3) ItemTemplate - 각 항목을 어떻게 보여줄지 (학생 카드 양식)
      4) SelectedItem 바인딩 - 선택한 항목 추적
      5) ListView와 GridView - 열이 있는 표 형태
    -->

    <Window.DataContext>
        <local:StudentViewModel />
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <!-- 왼쪽: 학생 목록 (55%) -->
            <ColumnDefinition Width="55*" />
            <!-- 오른쪽: 상세/입력 (45%) -->
            <ColumnDefinition Width="45*" />
        </Grid.ColumnDefinitions>

        <!-- ┌─────────────────────────────────────────┐ -->
        <!-- │  왼쪽: 학생 목록 (ListView + GridView)   │ -->
        <!-- └─────────────────────────────────────────┘ -->
        <!-- ListView의 GridView는 열 제목이 있는 표입니다.
             학교 출석부에 "번호, 이름, 학년" 열이 있는 것처럼! -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top"
                       Text="학생 목록"
                       FontSize="18" FontWeight="Bold"
                       Margin="0,0,0,8" />

            <!-- 검색 바 -->
            <TextBox DockPanel.Dock="Top"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="13"
                     Padding="8,5"
                     Margin="0,0,0,8">
                <!-- Watermark는 WPF 기본 지원이 아니므로 힌트 텍스트는 ViewModel에서 처리 -->
            </TextBox>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding StatusText}"
                       Foreground="Gray"
                       Margin="0,5,0,0" />

            <!-- ListView: SelectedItem을 ViewModel에 바인딩 -->
            <ListView ItemsSource="{Binding FilteredStudents}"
                      SelectedItem="{Binding SelectedStudent}"
                      FontSize="13">
                <ListView.View>
                    <!-- GridView: 열이 있는 표 형태 -->
                    <GridView>
                        <GridViewColumn Header="이름" Width="100"
                                        DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="학년" Width="60"
                                        DisplayMemberBinding="{Binding Grade}" />
                        <GridViewColumn Header="점수" Width="60"
                                        DisplayMemberBinding="{Binding Score}" />
                        <GridViewColumn Header="등급" Width="60">
                            <!-- CellTemplate: 특정 열의 셀 모양을 직접 정의 -->
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding GradeLevel}"
                                               FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GradeLevel}" Value="A">
                                                        <Setter Property="Foreground" Value="Green" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GradeLevel}" Value="F">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <!-- ┌─────────────────────────────────────────┐ -->
        <!-- │  오른쪽: 입력 + 상세 정보                │ -->
        <!-- └─────────────────────────────────────────┘ -->
        <StackPanel Grid.Column="1">
            <TextBlock Text="학생 추가"
                       FontSize="16" FontWeight="Bold"
                       Margin="0,0,0,10" />

            <!-- 입력 폼 -->
            <TextBlock Text="이름:" Margin="0,5" />
            <TextBox Text="{Binding InputName, UpdateSourceTrigger=PropertyChanged}"
                     Padding="5" FontSize="13" />

            <TextBlock Text="학년:" Margin="0,8,0,5" />
            <ComboBox SelectedItem="{Binding InputGrade}"
                      FontSize="13" Padding="5">
                <ComboBoxItem Content="1학년" />
                <ComboBoxItem Content="2학년" />
                <ComboBoxItem Content="3학년" />
                <ComboBoxItem Content="4학년" />
                <ComboBoxItem Content="5학년" />
                <ComboBoxItem Content="6학년" />
            </ComboBox>

            <TextBlock Text="점수 (0~100):" Margin="0,8,0,5" />
            <TextBox Text="{Binding InputScore, UpdateSourceTrigger=PropertyChanged}"
                     Padding="5" FontSize="13" />

            <!-- 버튼 -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="추가" Command="{Binding AddCommand}"
                        Padding="20,8" Margin="0,0,8,0"
                        Background="#FF4CAF50" Foreground="White" />
                <Button Content="삭제" Command="{Binding DeleteCommand}"
                        Padding="20,8"
                        Background="#FFF44336" Foreground="White" />
            </StackPanel>

            <!-- 선택된 학생 상세 정보 -->
            <Border Margin="0,20,0,0"
                    Padding="12"
                    Background="#FFF5F5F5"
                    CornerRadius="6"
                    BorderBrush="#FFE0E0E0"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="선택된 학생 정보"
                               FontSize="14" FontWeight="Bold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding SelectedStudentInfo}"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
