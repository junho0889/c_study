# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# ■ 파일명: Dockerfile.python
# ■ 목적: Python 멀티스테이지 빌드 - 이미지 크기 최적화
# ■ 비교: 일반 빌드 ~900MB → 멀티스테이지 ~150MB
# ■ 빌드: docker build -f Dockerfile.python -t python-optimized .
# ■ 날짜: 2026-03-21
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

# ============================================================
# 스테이지 1: 빌더 (Builder)
# ============================================================
# 이 단계에서는 패키지를 설치하고 컴파일하는 작업을 해
# gcc, build-essential 같은 빌드 도구가 필요하지만
# 최종 이미지에는 필요 없어! 그래서 분리하는 거야
FROM python:3.12-slim AS builder

# 빌드에 필요한 시스템 패키지 설치
# gcc = C 컴파일러 (일부 Python 패키지가 C로 된 부분이 있어)
# libpq-dev = PostgreSQL 연결 라이브러리 (psycopg2 빌드용)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*
# rm -rf /var/lib/apt/lists/* = apt 캐시 삭제 (이미지 크기 줄이기)

# 가상환경 만들기
# 왜 컨테이너 안에서 가상환경을 쓸까?
# → 멀티스테이지에서 설치한 패키지를 깔끔하게 복사하기 위해!
# → /opt/venv 폴더만 복사하면 모든 패키지가 같이 와
RUN python -m venv /opt/venv
# PATH에 가상환경 추가 → 이 뒤의 pip, python은 가상환경 것을 사용
ENV PATH="/opt/venv/bin:$PATH"

# requirements.txt 먼저 복사 (레이어 캐싱 최적화!)
# 이 파일이 바뀌지 않으면 pip install을 다시 안 해
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 소스코드 복사
COPY . /app

# ============================================================
# 스테이지 2: 프로덕션 (Production)
# ============================================================
# 새로운 깨끗한 이미지에서 시작!
# builder 단계의 gcc, apt 캐시 등은 여기 없어 → 이미지가 작아!
FROM python:3.12-slim AS production

# 런타임에 필요한 시스템 라이브러리만 설치
# libpq5 = PostgreSQL 클라이언트 라이브러리 (실행용, 빌드용 libpq-dev와 다름!)
# curl = 헬스체크용
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libpq5 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# 보안: 일반 사용자로 실행
RUN groupadd -r app && useradd -r -g app -d /app app

# builder에서 가상환경만 복사! (핵심!)
# 이것만으로 설치된 모든 Python 패키지가 넘어와
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# 소스코드 복사
COPY --from=builder --chown=app:app /app /app
WORKDIR /app

# 환경변수 설정
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENV=production

# 포트 문서화
EXPOSE 8000

# 헬스체크
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 일반 사용자로 전환
USER app

# gunicorn으로 프로덕션 실행 (Flask 내장 서버는 개발용이야!)
# -w 4 = 워커 4개 (CPU 코어 수 * 2 + 1 이 공식)
# -b 0.0.0.0:8000 = 모든 IP에서 8000 포트로 접속 허용
CMD ["gunicorn", "-w", "4", "-b", "0.0.0.0:8000", "app:app"]
