# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# ■ 파일명: Dockerfile.node
# ■ 목적: Node.js 멀티스테이지 빌드 - React 앱을 Nginx로 서빙
# ■ 비교: node 이미지 ~1GB → nginx-alpine ~30MB
# ■ 빌드: docker build -f Dockerfile.node -t node-optimized .
# ■ 날짜: 2026-03-21
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

# ============================================================
# 스테이지 1: 의존성 설치 (Dependencies)
# ============================================================
# node_modules만 설치하는 별도 스테이지
# package.json이 바뀌지 않으면 이 단계는 캐시돼!
FROM node:20-alpine AS deps

WORKDIR /app

# package.json과 lock 파일만 먼저 복사
# 이렇게 하면 소스코드가 바뀌어도 npm install을 다시 안 해
COPY package.json package-lock.json* ./

# npm ci = package-lock.json 기반으로 정확한 버전 설치
# npm install보다 빠르고 일관성 있어 (CI/CD 환경에 추천)
# --omit=dev = 개발용 패키지 제외 (eslint, jest 등은 빌드에만 필요)
RUN npm ci

# ============================================================
# 스테이지 2: 빌드 (Build)
# ============================================================
# React/Vue/Angular 앱을 빌드해서 정적 파일 생성
FROM node:20-alpine AS builder

WORKDIR /app

# deps 스테이지에서 node_modules 가져오기
COPY --from=deps /app/node_modules ./node_modules

# 소스코드 복사
COPY . .

# 빌드 실행
# React: npm run build → build/ 폴더에 정적 파일 생성
# Vue: npm run build → dist/ 폴더에 정적 파일 생성
# 결과물: HTML, CSS, JS 파일 (브라우저가 이해하는 것만!)
RUN npm run build

# ============================================================
# 스테이지 3: 프로덕션 (Nginx로 서빙)
# ============================================================
# Node.js는 더 이상 필요 없어!
# 빌드된 정적 파일을 Nginx가 서빙하면 돼
# Nginx Alpine 이미지는 ~30MB로 매우 가벼워
FROM nginx:1.27-alpine AS production

# Nginx 설정 파일 복사
# 기본 설정을 우리 앱에 맞게 교체
COPY nginx.conf /etc/nginx/conf.d/default.conf

# builder 스테이지에서 빌드된 정적 파일만 복사
# build/ 폴더 안에는 index.html, CSS, JS 파일만 있어
# Node.js, node_modules, 소스코드는 하나도 없어!
COPY --from=builder /app/build /usr/share/nginx/html

# 보안: Nginx를 non-root로 실행하기 위한 설정
# nginx 이미지의 기본 사용자 활용
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

# 포트 80번 문서화
EXPOSE 80

# 헬스체크: Nginx가 응답하는지 확인
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# Nginx를 포그라운드로 실행
# daemon off = 백그라운드가 아닌 포그라운드로 실행
# Docker는 포그라운드 프로세스가 있어야 컨테이너가 계속 실행돼
CMD ["nginx", "-g", "daemon off;"]

# ============================================================
# 이미지 크기 비교:
#
# 방법 1: Node.js로 직접 서빙
#   FROM node:20 + 소스코드 + node_modules
#   → 약 1GB 이상!
#
# 방법 2: 멀티스테이지 (이 파일)
#   FROM nginx:alpine + 빌드된 정적 파일만
#   → 약 30~50MB!
#
# 30배 가까이 줄어들어!
# 그리고 Node.js 취약점에도 영향을 안 받아 (없으니까!)
# ============================================================
