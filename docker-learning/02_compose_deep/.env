# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# ■ 파일명: .env
# ■ 목적: Docker Compose 환경변수 파일
# ■ 설명: docker-compose.yml에서 ${변수명}으로 참조됨
# ■ 주의: .gitignore에 추가해서 비밀번호가 Git에 올라가지 않게 해!
# ■ 날짜: 2026-03-21
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

# ━━━ 앱 설정 ━━━
# 앱이 실행되는 환경을 지정해
# development = 개발 모드 (디버그 활성화, 에러 자세히 보여줌)
# production = 운영 모드 (디버그 비활성화, 에러 숨김)
APP_ENV=development

# 앱 비밀 키 (세션, 토큰 암호화에 사용)
# 운영 환경에서는 반드시 복잡하고 긴 랜덤 문자열로 바꿔야 해!
APP_SECRET_KEY=my-super-secret-key-change-in-production

# ━━━ Nginx 설정 ━━━
# Nginx가 사용할 호스트 포트
# 80을 이미 사용 중이면 8080 등으로 바꿔
NGINX_PORT=80

# ━━━ PostgreSQL 데이터베이스 설정 ━━━
# DB 접속에 필요한 정보들
DB_USER=postgres
DB_PASSWORD=mysecretpassword123
DB_NAME=myapp
DB_PORT=5432

# ━━━ Redis 설정 ━━━
# Redis가 사용할 최대 메모리
# mb = 메가바이트, gb = 기가바이트
REDIS_MAXMEMORY=256mb

# ━━━ 로그 설정 ━━━
# 로그 레벨: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG = 모든 것을 기록 (개발용)
# INFO = 중요한 정보만 기록 (운영용)
LOG_LEVEL=DEBUG
