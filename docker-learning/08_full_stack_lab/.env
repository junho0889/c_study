# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# ■ 파일명: .env
# ■ 목적: 풀스택 실습 환경변수
# ■ 주의: 실제 운영에서는 이 파일을 .gitignore에 추가해!
# ■ 날짜: 2026-03-21
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

# ━━━ 앱 설정 ━━━
# 앱 실행 환경 (development / staging / production)
APP_ENV=development

# 앱 비밀 키 (세션 암호화, JWT 토큰 서명에 사용)
# 운영에서는 반드시 랜덤한 긴 문자열로 변경!
APP_SECRET_KEY=fullstack-lab-secret-key-2026

# ━━━ PostgreSQL 설정 ━━━
# 데이터베이스 접속 정보
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=fullstack
DB_PORT=5432

# ━━━ Redis 설정 ━━━
# Redis 최대 메모리 (캐시 저장소이므로 적당히)
REDIS_MAXMEMORY=128mb

# ━━━ Nginx 설정 ━━━
# Nginx가 사용할 호스트 포트
# 80이 사용 중이면 8080 등으로 변경
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ━━━ Prometheus 설정 ━━━
# 메트릭 데이터 보존 기간
PROMETHEUS_RETENTION=7d

# ━━━ 로그 설정 ━━━
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=DEBUG

# ━━━ 이미지 버전 ━━━
# 배포 시 특정 버전 지정
API_VERSION=latest
