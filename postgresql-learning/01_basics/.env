# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
# ■■■ PostgreSQL 환경 변수 설정                        ■■■
# ■■■ docker-compose.yml에서 ${변수명} 으로 참조       ■■■
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

# ■■■ PostgreSQL 설정 ■■■
POSTGRES_DB=study_db            # 기본 데이터베이스 이름
POSTGRES_USER=postgres          # 슈퍼유저 이름
POSTGRES_PASSWORD=postgres123   # 슈퍼유저 비밀번호 (프로덕션에서는 강력한 비밀번호 사용!)
POSTGRES_PORT=5432              # 호스트에서 접근할 포트 번호

# ■■■ pgAdmin 설정 ■■■
PGADMIN_EMAIL=admin@admin.com   # pgAdmin 로그인 이메일
PGADMIN_PASSWORD=admin123       # pgAdmin 로그인 비밀번호
PGADMIN_PORT=5050               # pgAdmin 웹 UI 포트 (http://localhost:5050)

# ■■■ 타임존 ■■■
TZ=Asia/Seoul                   # 한국 표준시 (KST, UTC+9)

# ■■■ PostgreSQL 성능 설정 ■■■
# docker-compose.yml의 command에서 참조 가능
PG_SHARED_BUFFERS=128MB         # 공유 버퍼 (RAM의 25% 권장)
PG_WORK_MEM=4MB                 # 정렬/해시 작업 메모리
PG_MAINTENANCE_WORK_MEM=64MB    # VACUUM, CREATE INDEX 메모리
PG_MAX_CONNECTIONS=100          # 최대 동시 연결 수
PG_LOG_STATEMENT=all            # SQL 로깅 (all: 전체, none: 비활성화)
