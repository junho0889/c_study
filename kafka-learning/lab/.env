##############################################################################
# ■■■ Kafka Lab 환경 변수 설정 파일 ■■■
#
# 이 파일의 값들은 docker-compose.yml 에서 ${변수명:-기본값} 형태로 참조됨
# 값을 변경한 후 docker-compose up -d 로 반영
##############################################################################

# ── Confluent Platform 버전 ──
# Confluent 공식 이미지 태그 (Docker Hub: confluentinc/cp-kafka)
# https://hub.docker.com/r/confluentinc/cp-kafka/tags 에서 확인 가능
CONFLUENT_VERSION=7.6.0

# ── Zookeeper 설정 ──
# 클라이언트 연결 포트 (호스트에서 접근 시)
ZK_CLIENT_PORT=2181
# 틱 타임 (밀리초) - Zookeeper 내부 시간 단위
ZK_TICK_TIME=2000
# JVM 힙 메모리 (실습: 256M, 프로덕션: 1G 이상 권장)
ZK_HEAP_SIZE=256M

# ── Kafka 브로커 외부 포트 ──
# 호스트 머신에서 각 브로커에 접근할 때 사용하는 포트
# producer.py, consumer.py 에서 이 포트로 접속
KAFKA_BROKER1_EXTERNAL_PORT=9092
KAFKA_BROKER2_EXTERNAL_PORT=9093
KAFKA_BROKER3_EXTERNAL_PORT=9094

# ── Kafka 토픽 기본 설정 ──
# 토픽 자동 생성 여부 (true: 존재하지 않는 토픽에 produce 시 자동 생성)
# 프로덕션에서는 false 권장 (의도하지 않은 토픽 생성 방지)
KAFKA_AUTO_CREATE_TOPICS=true
# 새 토픽의 기본 파티션 수 (병렬 처리 단위)
# 파티션이 많을수록 처리량 증가, 단 리밸런싱 시간도 증가
KAFKA_DEFAULT_PARTITIONS=3
# 기본 리플리케이션 팩터 (데이터 복제본 수)
# 3으로 설정하면 1대가 장애나도 데이터 손실 없음
KAFKA_DEFAULT_REPLICATION=3
# 최소 In-Sync Replicas 수
# acks=all 일 때 이 수만큼 복제되어야 쓰기 성공 처리
KAFKA_MIN_ISR=2

# ── Kafka 로그 보존 설정 ──
# 메시지 보존 기간 (시간), 168시간 = 7일
KAFKA_LOG_RETENTION_HOURS=168
# 로그 세그먼트 파일 최대 크기 (바이트), 1073741824 = 1GB
KAFKA_LOG_SEGMENT_BYTES=1073741824

# ── Kafka 내부 토픽 설정 ──
# __consumer_offsets 토픽의 리플리케이션 팩터
KAFKA_OFFSETS_REPLICATION=3

# ── Kafka 브로커 JVM 설정 ──
# 힙 메모리 (실습: 512M, 프로덕션: 6G 이상 권장)
KAFKA_HEAP_SIZE=512M

# ── Kafka UI 설정 ──
# Kafka UI 이미지 버전
KAFKA_UI_VERSION=latest
# Kafka UI 웹 접속 포트
KAFKA_UI_PORT=8080
# UI에 표시될 클러스터 이름
KAFKA_CLUSTER_NAME=local-kafka-cluster
